{
  "name": "chalk-vscode",
  "displayName": "Chalk LSP",
  "version": "0.0.0",
  "description": "Chalk language intelligence and typechecking for Python and SQL resolvers",
  "publisher": "chalk-ai",
  "license": "MIT",
  "icon": "resources/chalk.png",
  "pricing": "Free",
  "main": "dist/extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/chalk-ai/chalk-vscode.git"
  },
  "homepage": "https://docs.chalk.ai",
  "bugs": "https://github.com/chalk-ai/chalk-vscode/issues",
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "chalk",
    "chalk ai",
    "python",
    "sql",
    "feature platform",
    "type checker",
    "language server",
    "lsp"
  ],
  "engines": {
    "vscode": "^1.96.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "activationEvents": [
    "workspaceContains:**/chalk.yml",
    "workspaceContains:**/chalk.yaml",
    "onCommand:chalk-lsp.updateServer",
    "onCommand:chalk-lsp.restartServer",
    "onCommand:chalk-lsp.showOutput",
    "onCommand:chalk-lsp.configureWorkspace"
  ],
  "contributes": {
    "commands": [
      {
        "command": "chalk-lsp.showConfig",
        "title": "Chalk: Show Configuration"
      },
      {
        "command": "chalk-lsp.updateServer",
        "title": "Chalk: Update Language Server"
      },
      {
        "command": "chalk-lsp.restartServer",
        "title": "Chalk: Restart Language Server"
      },
      {
        "command": "chalk-lsp.showOutput",
        "title": "Chalk: Show Language Server Output"
      },
      {
        "command": "chalk-lsp.configureWorkspace",
        "title": "Chalk: Configure Workspace"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "tsc",
    "watch": "tsc --watch",
    "package": "vsce package",
    "publish:vsce": "vsce publish",
    "publish:open-vsx": "ovsx publish"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "tar": "^7.4.3",
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/vscode": "^1.96.0",
    "@vscode/vsce": "^3.2.1",
    "ovsx": "^0.10.2",
    "typescript": "^5.7.2"
  }
}
